# Copy this file to .env only if you want to keep local overrides.
# Never commit the real .env file.
DJANGO_SECRET_KEY=replace-with-a-long-random-development-value

# Defaults for services started directly on the host.
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
EMAIL_REDIS_URL=redis://127.0.0.1:6379/2

# The demo provider records deliveries in Redis and sends no real email.
EMAIL_PROVIDER_MODE=demo

# Only required when EMAIL_PROVIDER_MODE=http.
EMAIL_PROVIDER_URL=
EMAIL_PROVIDER_API_KEY=
